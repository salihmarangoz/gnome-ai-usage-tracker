<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ai-usage-tracker" path="/org/gnome/shell/extensions/ai-usage-tracker/">
    <key name="claude-show" type="s">
      <choices>
        <choice value="both"/>
        <choice value="panel"/>
        <choice value="menu"/>
        <choice value="off"/>
      </choices>
      <default>'both'</default>
      <summary>Where to show Claude Code usage</summary>
    </key>
    <key name="claude-display" type="s">
      <choices>
        <choice value="usage"/>
        <choice value="remaining"/>
      </choices>
      <default>'usage'</default>
      <summary>Show what is used or what is remaining of Claude Code</summary>
    </key>
    <key name="claude-refresh-interval" type="u">
      <!-- Claude throttles its usage endpoint when polled more often -->
      <range min="5" max="120"/>
      <default>10</default>
      <summary>Minutes between Claude Code usage updates</summary>
    </key>
    <key name="codex-show" type="s">
      <choices>
        <choice value="both"/>
        <choice value="panel"/>
        <choice value="menu"/>
        <choice value="off"/>
      </choices>
      <default>'both'</default>
      <summary>Where to show Codex usage</summary>
    </key>
    <key name="codex-display" type="s">
      <choices>
        <choice value="usage"/>
        <choice value="remaining"/>
      </choices>
      <default>'usage'</default>
      <summary>Show what is used or what is remaining of Codex</summary>
    </key>
    <key name="codex-refresh-interval" type="u">
      <range min="1" max="120"/>
      <default>10</default>
      <summary>Minutes between Codex usage updates</summary>
    </key>
    <key name="show-icon" type="b">
      <default>false</default>
      <summary>Show the icon in the top bar</summary>
    </key>
    <key name="icon-style" type="s">
      <choices>
        <choice value="gauge"/>
        <choice value="bars"/>
      </choices>
      <default>'gauge'</default>
      <summary>Gauge icon, or small usage bars for each service</summary>
    </key>
  </schema>
</schemalist>
