<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.ai-usage-tracker" path="/org/gnome/shell/extensions/ai-usage-tracker/">
    <!-- Claude Code -->
    <key name="claude-show" type="s">
      <choices>
        <choice value="both"/>
        <choice value="panel"/>
        <choice value="menu"/>
        <choice value="off"/>
      </choices>
      <default>'both'</default>
      <summary>Where to show Claude Code usage</summary>
    </key>
    <key name="claude-display" type="s">
      <choices>
        <choice value="usage"/>
        <choice value="remaining"/>
      </choices>
      <default>'usage'</default>
      <summary>Show what is used or what is remaining of Claude Code</summary>
    </key>
    <key name="claude-refresh-interval" type="u">
      <!-- Claude throttles its usage endpoint when polled more often -->
      <range min="5" max="120"/>
      <default>10</default>
      <summary>Minutes between Claude Code usage updates</summary>
    </key>
    <key name="claude-panel-limits" type="s">
      <choices>
        <choice value="both"/>
        <choice value="short"/>
        <choice value="long"/>
      </choices>
      <default>'both'</default>
      <summary>Claude Code limits shown in the top bar (5-hour, weekly or both)</summary>
    </key>
    <key name="claude-show-name" type="b">
      <default>true</default>
      <summary>Show the Claude name in the top bar</summary>
    </key>
    <key name="claude-color" type="s">
      <default>'#d97757'</default>
      <summary>Claude Code bar colour</summary>
    </key>

    <!-- Codex -->
    <key name="codex-show" type="s">
      <choices>
        <choice value="both"/>
        <choice value="panel"/>
        <choice value="menu"/>
        <choice value="off"/>
      </choices>
      <default>'both'</default>
      <summary>Where to show Codex usage</summary>
    </key>
    <key name="codex-display" type="s">
      <choices>
        <choice value="usage"/>
        <choice value="remaining"/>
      </choices>
      <default>'usage'</default>
      <summary>Show what is used or what is remaining of Codex</summary>
    </key>
    <key name="codex-refresh-interval" type="u">
      <range min="1" max="120"/>
      <default>10</default>
      <summary>Minutes between Codex usage updates</summary>
    </key>
    <key name="codex-panel-limits" type="s">
      <choices>
        <choice value="both"/>
        <choice value="short"/>
        <choice value="long"/>
      </choices>
      <default>'both'</default>
      <summary>Codex limits shown in the top bar (5-hour, weekly or both)</summary>
    </key>
    <key name="codex-show-name" type="b">
      <default>true</default>
      <summary>Show the Codex name in the top bar</summary>
    </key>
    <key name="codex-color" type="s">
      <default>'#3584e4'</default>
      <summary>Codex bar colour</summary>
    </key>

    <!-- Top bar -->
    <key name="show-bars" type="b">
      <default>false</default>
      <summary>Show small usage bars in the top bar</summary>
    </key>
    <key name="bar-length" type="u">
      <range min="8" max="60"/>
      <default>18</default>
      <summary>Length of the top bar usage bars in pixels</summary>
    </key>
    <key name="bar-thickness" type="u">
      <range min="2" max="10"/>
      <default>4</default>
      <summary>Thickness of the top bar usage bars in pixels</summary>
    </key>
    <key name="show-app-icon" type="b">
      <default>false</default>
      <summary>Show the gauge icon in the top bar</summary>
    </key>
  </schema>
</schemalist>
